					 <STM32_PINMUX('C', 10, ANALOG)>, /* I2S3_CK */
					 <STM32_PINMUX('D', 10, ANALOG)>; /* I2S3_SDI */
		};
	};

	m4_spi2_pins_mx: m4_spi2_mx-0 {
