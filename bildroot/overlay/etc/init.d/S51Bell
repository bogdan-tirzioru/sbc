#!/bin/sh
#
# Starts doorbell.
#


start() {
	cd /root
	printf "Starting doorbell: "
	python doorbell.py &
	echo "OK"
}
stop() {
	printf "Stopping doorbell: "
	echo "OK"
}
restart() {
	stop
	start
}

case "$1" in
  start)
	start
	;;
  stop)
	stop
	;;
  restart|reload)
	restart
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?

